{
  "name": "lancast",
  "version": "1.5.2",
  "description": "Stream your Windows desktop to a TV over your local network. No internet, no cloud, no account.",
  "main": "./out/main/index.js",
  "author": "Monssef",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "build:virtual-camera": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-virtual-camera.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsc src/main/command.ts src/main/validation.ts src/main/hls-server.ts src/main/phone-camera.ts --outDir out-test --module esnext --target es2022 --moduleResolution bundler --skipLibCheck && node --test tests/*.test.mjs",
    "dist": "npm run fetch:ffmpeg && electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "electron-updater": "^6.8.9",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
